+/*
+ * Remove clients that associated but never sent any data. Spurious
+ * association frames (channel scan, foreign devices) create such clients.
+ * They never go away on their own, and each one keeps a slot and stops the
+ * pairing channel scan. Must run on event_wq.
+ * Returns true if a client is still inside its handshake window.
+ */
+static bool xone_dongle_reap_clients(struct xone_dongle *dongle)
+{
+	struct xone_dongle_client *client;
+	bool pending = false;
+	int i;
+
+	for (i = 0; i < XONE_DONGLE_MAX_CLIENTS; i++) {
+		client = dongle->clients[i];
+		if (!client || READ_ONCE(client->seen_data))
+			continue;
+
+		if (time_before(jiffies, client->assoc_time +
+					 XONE_DONGLE_HANDSHAKE_TIMEOUT)) {
+			pending = true;
+			continue;
+		}
+
+		dev_dbg(dongle->mt.dev, "%s: wcid=%d sent no data, removing\n",
+			__func__, client->wcid);
+		xone_dongle_remove_client(dongle, client->wcid);
+	}
+
+	return pending;
+}
+
+static void xone_dongle_reap_work(struct work_struct *work)
+{
+	struct xone_dongle *dongle = container_of(to_delayed_work(work),
+						  typeof(*dongle),
+						  reap_work);
+
+	if (dongle->fw_state != XONE_DONGLE_FW_STATE_READY)
+		return;
+
+	if (xone_dongle_reap_clients(dongle))
+		queue_delayed_work(dongle->event_wq, &dongle->reap_work,
+				   XONE_DONGLE_HANDSHAKE_TIMEOUT);
+}
+
+/* Remove every client without waiting for the controllers. */
+static void xone_dongle_drop_clients(struct xone_dongle *dongle)
+{
+	int i;
+
+	for (i = 0; i < XONE_DONGLE_MAX_CLIENTS; i++)
+		if (dongle->clients[i])
+			xone_dongle_remove_client(dongle, i + 1);
+
+	atomic_set(&dongle->client_count, 0);
+}
+
+/* Stop the event queue. No client changes can run after this returns. */
+static void xone_dongle_quiesce_events(struct xone_dongle *dongle)
+{
+	cancel_delayed_work_sync(&dongle->reap_work);
+	drain_workqueue(dongle->event_wq);
+	/* an event that ran during the drain can have armed it again */
+	cancel_delayed_work_sync(&dongle->reap_work);
+}
